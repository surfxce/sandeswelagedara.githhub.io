{
  "rules": {
    ".read": false,
    ".write": false,
    "spice-road": {
      "scores": {
        ".read": true,
        "$match": {
          ".write": true,
          ".validate": "newData.hasChildren(['sport', 'a', 'b', 'sa', 'sb', 'status', 't'])",
          "sport": {
            ".validate": "newData.isString() && newData.val().matches(/^(vb|fb|ck)$/)"
          },
          "a": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
          },
          "b": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
          },
          "sa": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
          },
          "sb": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
          },
          "status": {
            ".validate": "newData.isString() && newData.val().matches(/^(live|done)$/)"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "ended": {
            ".validate": "newData.isNumber()"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "broadcasts": {
        ".read": true,
        "$post": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['text', 'by', 't'])",
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 280"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "brackets": {
        ".read": true,
        "$sport": {
          ".write": true,
          ".validate": "$sport.matches(/^(vb|fb|ck)$/) && newData.hasChildren(['teams', 'rounds', 't'])",
          "teams": {
            ".validate": "newData.hasChildren()"
          },
          "rounds": {
            ".validate": "newData.hasChildren()"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "swaps": {
        ".read": true,
        "$id": {
          ".write": true,
          ".validate": "newData.hasChildren(['from', 'block', 'duty', 'status', 't'])",
          "from": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "block": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 11"
          },
          "duty": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "status": {
            ".validate": "newData.isString() && newData.val().matches(/^(open|taken|withdrawn)$/)"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "to": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "tt": {
            ".validate": "newData.isNumber()"
          },
          "declines": {
            "$name": {
              ".validate": "newData.isBoolean()"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "help": {
        ".read": true,
        "$id": {
          ".write": true,
          ".validate": "newData.hasChildren(['from', 'block', 'duty', 'status', 't'])",
          "from": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "block": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 11"
          },
          "duty": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "status": {
            ".validate": "newData.isString() && newData.val().matches(/^(open|closed)$/)"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "tt": {
            ".validate": "newData.isNumber()"
          },
          "responders": {
            "$name": {
              ".validate": "newData.isBoolean()"
            }
          },
          "declines": {
            "$name": {
              ".validate": "newData.isBoolean()"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "dm": {
        ".read": true,
        "$pair": {
          "$msg": {
            ".write": "!data.exists()",
            ".validate": "newData.hasChildren(['from', 'to', 'text', 't']) && $pair.length <= 90",
            "from": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "to": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "photos": {
        ".read": true,
        ".indexOn": [
          "status"
        ],
        "$id": {
          ".write": true,
          ".validate": "newData.hasChildren(['data', 'status', 't'])",
          "data": {
            ".validate": "newData.isString() && newData.val().beginsWith('data:image/jpeg;base64,') && newData.val().length <= 400000"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "cap": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "status": {
            ".validate": "newData.isString() && newData.val().matches(/^(pending|approved|rejected)$/)"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "tt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
