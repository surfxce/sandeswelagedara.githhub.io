          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 24 && !(newData.val().matches(/.*[^a-z](pee|peehole|peanits|peenis|penus|pen1s|peniss|wee|poo|poop|urine|blowjob|handjob|boner|erection|nipple|nipples|butthole|anus|anal|scrotum|testicle|testicles|vulva|clit|milf|thot|simp|genitals|fuck|fucking|fucker|fucked|fck|shit|shitty|sh1t|bitch|bitches|bastard|cunt|cock|cocks|dick|dickhead|pussy|twat|wank|wanker|slut|sluts|whore|whores|arsehole|asshole|prick|bollocks|tits|boobs|nude|nudes|naked|porn|porno|sex|sexy|sexual|penis|vagina|dildo|orgasm|cum|jizz|horny|rape|rapist|molest|nigga|nigger|chink|paki|spic|kike|fag|faggot|retard|retarded|tranny|dyke|coon|gook|wog|kys|hitler|nazi|nazis|terrorist)[^a-z].*/i) || newData.val().matches(/^(pee|peehole|peanits|peenis|penus|pen1s|peniss|wee|poo|poop|urine|blowjob|handjob|boner|erection|nipple|nipples|butthole|anus|anal|scrotum|testicle|testicles|vulva|clit|milf|thot|simp|genitals|fuck|fucking|fucker|fucked|fck|shit|shitty|sh1t|bitch|bitches|bastard|cunt|cock|cocks|dick|dickhead|pussy|twat|wank|wanker|slut|sluts|whore|whores|arsehole|asshole|prick|bollocks|tits|boobs|nude|nudes|naked|porn|porno|sex|sexy|sexual|penis|vagina|dildo|orgasm|cum|jizz|horny|rape|rapist|molest|nigga|nigger|chink|paki|spic|kike|fag|faggot|retard|retarded|tranny|dyke|coon|gook|wog|kys|hitler|nazi|nazis|terrorist)[^a-z].*/i) || newData.val().matches(/.*[^a-z](pee|peehole|peanits|peenis|penus|pen1s|peniss|wee|poo|poop|urine|blowjob|handjob|boner|erection|nipple|nipples|butthole|anus|anal|scrotum|testicle|testicles|vulva|clit|milf|thot|simp|genitals|fuck|fucking|fucker|fucked|fck|shit|shitty|sh1t|bitch|bitches|bastard|cunt|cock|cocks|dick|dickhead|pussy|twat|wank|wanker|slut|sluts|whore|whores|arsehole|asshole|prick|bollocks|tits|boobs|nude|nudes|naked|porn|porno|sex|sexy|sexual|penis|vagina|dildo|orgasm|cum|jizz|horny|rape|rapist|molest|nigga|nigger|chink|paki|spic|kike|fag|faggot|retard|retarded|tranny|dyke|coon|gook|wog|kys|hitler|nazi|nazis|terrorist)$/i) || newData.val().matches(/^(pee|peehole|peanits|peenis|penus|pen1s|peniss|wee|poo|poop|urine|blowjob|handjob|boner|erection|nipple|nipples|butthole|anus|anal|scrotum|testicle|testicles|vulva|clit|milf|thot|simp|genitals|fuck|fucking|fucker|fucked|fck|shit|shitty|sh1t|bitch|bitches|bastard|cunt|cock|cocks|dick|dickhead|pussy|twat|wank|wanker|slut|sluts|whore|whores|arsehole|asshole|prick|bollocks|tits|boobs|nude|nudes|naked|porn|porno|sex|sexy|sexual|penis|vagina|dildo|orgasm|cum|jizz|horny|rape|rapist|molest|nigga|nigger|chink|paki|spic|kike|fag|faggot|retard|retarded|tranny|dyke|coon|gook|wog|kys|hitler|nazi|nazis|terrorist)$/i))"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "incidents": {
        ".read": true,
        "$id": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['type', 'text', 'by', 't'])",
          "type": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 400"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "block": {
            ".validate": "newData.isNumber()"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "sim": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['on', 'start', 'startMin', 'speed'])",
        "on": {
          ".validate": "newData.isBoolean()"
        },
        "start": {
          ".validate": "newData.isNumber()"
        },
        "startMin": {
          ".validate": "newData.isNumber()"
        },
        "speed": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 120"
        },
        "$other": {
          ".validate": false
        }
      },
      "config": {
        ".read": true,
        "aiReview": {
          ".write": true,
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      },
      "spicy": {
        ".read": true,
        "$id": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['q', 'by', 'soc', 'notes', 't'])",
          "q":     { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300" },
          "by":    { ".validate": "newData.isString() && newData.val().length <= 40" },
          "soc":   { ".validate": "newData.isString() && newData.val().length <= 12" },
          "blk":   { ".validate": "newData.isNumber()" },
          "notes": { ".validate": "newData.isString() && newData.val().length <= 40000" },
          "hist":  { ".validate": "newData.isString() && newData.val().length <= 4000" },
          "t":     { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "spicy-cache": { ".read": true },
      "pfp": {
        ".read": true,
        "$first": {
          ".write": true,
          ".validate": "$first.matches(/^[a-z-]{1,30}$/) && newData.isString() && newData.val().beginsWith('data:image/jpeg;base64,') && newData.val().length <= 24000"
        }
      },
      "spicy-usage": { ".read": true }
    }
